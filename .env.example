# DizerCore-AI  
# ============================================================================  
# .env.example — environment template for DizerCore-AI.  
# The installer writes real values to /mnt/dizerdata/dizercore/dizercore.env  
# (set via DIZER_DATA_DIR). To change settings on a live install, edit that  
# file then:  sudo systemctl restart dizercore  
# ============================================================================  
  
# ---- API keys ----  
# OpenAI/ChatGPT coder key — _openai_once/_openai_stream_once  
# (runtime.cfg.openai_key). Coding traffic goes HERE, not OpenRouter.  
# NOTE: requests still fail on 429 if the account has no credits.  
OPENAI_API_KEY=your-openai-key  
  
# Groq API key — _groq_once (runtime.cfg.groq_key).  
GROQ_API_KEY=your-groq-key  
  
# Gemini API key — _gemini_once (runtime.cfg.gemini_key).  
GEMINI_API_KEY=your-gemini-key  
  
# OpenRouter key — JUDGE POOL ONLY (_judge_once, runtime.cfg.judge_key).  
# Required: it is the only OpenRouter key left.  
OPENROUTER_API_KEY_JUDGE=your-openrouter-judge-key  
  
# ---- ChatGPT (OpenAI) coder tiers ----  
# Comma-separated slug lists per complexity tier. Complexity 1-5 picks ONE  
# tier: 1-2 light, 3 normal, 4-5 heavy. First slug tried first; on HTTP  
# 401/402/403/404/429 or junk output the call rotates to the next slug.  
# Free tier = 50 RPD per model — the lists are failover runway.  
# Use ONLY chat-completions-compatible slugs: codex/responses-only models  
# (e.g. gpt-5.3-codex) return 404 "use the v1/responses endpoint".  
OPENAI_MODEL_LIGHT=gpt-4o-mini,gpt-4.1-mini  
OPENAI_MODEL_NORMAL=gpt-4.1,gpt-4o  
OPENAI_MODEL_HEAVY=gpt-4.1  
  
# ---- Groq tiers ----  
# Valid slugs for your account: run  
#   curl -H "Authorization: Bearer $GROQ_API_KEY" \  
#        https://api.groq.com/openai/v1/models  
GROQ_MODEL_LIGHT=openai/gpt-oss-20b,llama-3.1-8b-instant  
GROQ_MODEL_NORMAL=openai/gpt-oss-120b,openai/gpt-oss-20b  
GROQ_MODEL_HEAVY=openai/gpt-oss-120b,llama-3.3-70b-versatile  
  
# ---- Gemini tiers ----  
GEMINI_MODEL_LIGHT=gemini-2.0-flash-lite  
GEMINI_MODEL_NORMAL=gemini-2.5-flash  
GEMINI_MODEL_HEAVY=gemini-2.5-pro,gemini-2.5-flash  
  
# ---- Judge pool (OpenRouter only, reasoning enabled on every slug) ----  
JUDGE_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,google/gemma-4-31b-it:free,thinkingmachines/inkling:free,qwen/qwen3.8-27b:free  
JUDGE_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,cohere/north-mini-code:free,nvidia/nemotron-3.5-lightning:free,meta-llama/llama-3.3-70b-instruct:free  
  
# ---- Vision routing ----  
# Substring markers matched against slugs (config.VISION_MODELS). Binaries go  
# inline on matching OpenAI slugs and all Gemini models; Groq gets a note.  
  
# ---- Timing ----  
RATE_LIMIT_DELAY=3  
JUDGE_DELAY=5  
MAX_SAFETYWALL_TRIES=3  
RETRY_DELAY=4  
  
# ---- Storage ----  
# DIZER_DATA_DIR=/mnt/dizerdata/dizercore  
  
# ---- Two-Pi build executor (edith -> tadashi, SSH+rsync only) ----  
# Master switch. When unset/false the pipeline behaves exactly as before —  
# no SSH is attempted. install.sh sets this true after the SSH smoke test.  
BUILD_ENABLED=false  
  
# pi2 "tadashi" connection — dedicated sandboxed build box, holds NO secrets.  
# BUILD_HOST: IP/hostname of the executor Pi (blank = disabled).  
# BUILD_USER: remote system user created by install-executor.sh.  
# BUILD_KEY_PATH: edith-side ed25519 key generated by install.sh.  
BUILD_HOST=  
BUILD_USER=dizerbuild  
BUILD_KEY_PATH=~/.ssh/dizerbuild_ed25519  
  
# Remote layout on tadashi — install-executor.sh creates these on the NVMe:  
#   $BUILD_ROOT/jobs/<job_id>/  per-job workspaces (rsync target)  
#   $BUILD_ROOT/repo.git        seeded bare repo for tree mode  
BUILD_ROOT=/mnt/build  
  
# Build/repair loop — total attempts = BUILD_MAX_RETRIES + 1. Attempt n>=2  
# escalates coder tier: light -> normal -> heavy.  
BUILD_MAX_RETRIES=2  
BUILD_TIMEOUT_S=600          # per-command wall clock, file mode  
BUILD_TIMEOUT_TREE=7200      # per-command wall clock, tree mode (cmake)  
  
# Sandbox resource caps applied via bwrap --unshare-all + prlimit on tadashi.  
BUILD_JOBS=4                 # -j for make/cmake  
BUILD_MEM_MB=3072            # address-space cap  
BUILD_CPU_S=3600             # cpu-seconds cap  
  
# Tree mode gate — comma-separated clone-URL allowlist. build_repo values  
# not matching an entry here are rejected at /run with HTTP 400.  
ALLOWED_REPOS=
