# ---- API keys (required) ----  
OPENROUTER_API_KEY=your-openrouter-key  
GROQ_API_KEY=gsk_your_real_key_here  
GEMINI_API_KEY=your-google-ai-studio-key  
  
# ---- Data dir (SSD) ----  
DIZER_DATA_DIR=/mnt/dizerdata/dizercore  
PORT=8000  
  
# ---- Concurrency / throttle ----  
MAX_CONCURRENT_JOBS=2  
# Seconds to wait before EACH outbound model call (stops free-tier burst 429s).  
RATE_LIMIT_DELAY=6  
# Max slugs tried per tier before giving up. Must be >= the longest tier list  
# so every fallback slug is reachable.  
MAX_SAFETYWALL_TRIES=8  
  
# ---- OpenRouter code-generation models, per complexity tier (comma-separated) --  
# The pipeline tries each slug in order and rotates to the next on junk/error.  
# Complexity 1-2 -> LIGHT, 3 -> NORMAL, 4-5 -> HEAVY. These slugs PRODUCE code.  
# NOTE: the env var name is {PROVIDER}_MODEL_{TIER} (singular MODEL), matching  
# _tier_map("OPENROUTER_MODEL", ...) in config.py.  
OPENROUTER_MODEL_LIGHT=liquid/lfm-2.5-2.6b:free,nvidia/nemotron-3.5-lightning:free,poolside/laguna-xs-2.1:free,google/gemma-4-26b-a4b-it:free,thinkingmachines/inkling-small:free,nex-agi/nex-n2.5-mini:free,cohere/north-mini-code:free  
OPENROUTER_MODEL_NORMAL=poolside/laguna-s-2.1:free,google/gemma-4-31b-it:free,thinkingmachines/inkling:free,nex-agi/nex-n2.5-pro:free  
OPENROUTER_MODEL_HEAVY=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free  
  
# ---- Groq model rotation, per tier (comma-separated) ----  
# VERIFIED limits (Groq console, Default Project):  
#   gpt-oss-20b / gpt-oss-120b / qwen3.6-27b / qwen3.8-27b:  
#       30 RPM, 1,000 req/day, 8K TOKENS/MINUTE (prompt+output), 200K tokens/day  
#   groq/compound, groq/compound-mini:  
#       30 RPM, 250 req/day, 70K TOKENS/MINUTE, no daily token cap  
# The 8K TPM cap on gpt-oss/qwen is the real limit — large prompts 429/413 there.  
# compound* has 70K TPM headroom but only 250 req/day, so it sits LAST as a  
# big-payload fallback. Audio (orpheus/whisper) + safety classifiers excluded.  
GROQ_MODEL_LIGHT=openai/gpt-oss-20b,qwen/qwen3.6-27b,groq/compound-mini  
GROQ_MODEL_NORMAL=openai/gpt-oss-120b,qwen/qwen3.8-27b,groq/compound  
GROQ_MODEL_HEAVY=openai/gpt-oss-120b,qwen/qwen3.8-27b,groq/compound
  
# ---- Gemini model rotation, per tier (comma-separated) ----  
# Flash-Lite = 500 req/day, 15 RPM; full Flash = 20 req/day, 5 RPM. Lead every  
# tier with Flash-Lite for headroom; full Flash is heavy-only with Flash-Lite  
# as the fallback once the 20/day cap is exhausted.  
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite,gemini-3.1-flash-lite  
GEMINI_MODEL_NORMAL=gemini-3.5-flash-lite,gemini-3.1-flash-lite  
GEMINI_MODEL_HEAVY=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
  
# ---- Judge models — score each agent's output, highest AVERAGE wins ----  
# All JUDGE_MODELS score every candidate. Any judge that errors or returns  
# non-numeric output is DISCARDED and replaced by the next unused slug from  
# JUDGE_FALLBACK_MODELS. The surviving numeric scores are averaged.  
JUDGE_MODELS=inclusionai/ling-3.0-flash-vl:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,nvidia/nemotron-3.5-content-safety:free  
# Optional spare judges (comma-separated); used only to replace a dropped judge.  
JUDGE_FALLBACK_MODELS=
