# DizerCore-AI  
# ============================================================================  
# .env.example — environment template for DizerCore-AI.  
# The installer writes the real values to /mnt/dizerdata/dizercore/dizercore.env  
# (set via DIZER_DATA_DIR). To change settings on a live install, edit that file  
# then:  sudo systemctl restart dizercore  
# ============================================================================  
  
# ---- API keys (required) ----  
# Coding agents authenticate with OPENROUTER_API_KEY_CODER — used by  
# _openrouter_once (runtime.cfg.openrouter_key) for every slug in the  
# *_MODEL_* tier lists below.  
OPENROUTER_API_KEY_CODER=your-openrouter-coder-key  
  
# Dedicated judge key — used by _judge_once (runtime.cfg.judge_key) for every  
# slug in JUDGE_MODELS. Optional: if unset or empty, judging falls back to the  
# coder key and shares its rate limits.  
OPENROUTER_API_KEY_JUDGE=  
  
# Groq API key — used by _groq_once (runtime.cfg.groq_key).  
GROQ_API_KEY=your-groq-key  
  
# Gemini API key — used by _gemini_once (runtime.cfg.gemini_key).  
GEMINI_API_KEY=your-gemini-key  
  
# ---- OpenRouter coder tiers ----  
# Comma-separated slug lists per complexity tier. Complexity 1-5 picks ONE  
# tier for the whole job: 1-2 light, 3 normal, 4-5 heavy. First slug is tried  
# first; on HTTP 401/402/403/429 or empty/junk output the call rotates to the  
# next slug. All seven slugs below are reasoning-capable and stream both  
# content and reasoning deltas.  
OPENROUTER_MODEL_LIGHT=poolside/laguna-xs-2.1:free,cohere/north-mini-code:free,thinkingmachines/inkling-small:free  
OPENROUTER_MODEL_NORMAL=poolside/laguna-s-2.1:free,thinkingmachines/inkling:free,qwen/qwen3.8-27b:free  
OPENROUTER_MODEL_HEAVY=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free  
  
# ---- Judge pool ----  
# Scores each candidate 0-100 with SCORE:/COMMENTS: output. Pool is ordered  
# best-first; each candidate starts judging at a rotated index  
# (OpenRouter->0, Groq->last, Gemini->1) and wraps until a usable score lands.  
# All three are reasoning models; the 2048-token judge cap gives them room to  
# think before emitting SCORE:.  
JUDGE_MODELS=google/gemma-4-26b-a4b-it:free,dots-studio/dots-3-note-preview:free,liquid/lfm-2.5-2.6b:free  
# Optional spare judges (comma-separated); appended to the end of JUDGE_MODELS  
# rotation order and tried only after every primary slug fails.  
# Reasonable spares: the heavy coder tier (all reasoning-capable).  
JUDGE_FALLBACK_MODELS=  
# NOTE: thinkingmachines/inkling slugs previously lived here but return  
# 403 "only available on agentic harnesses" on plain chat/completions calls —  
# they moved to the coder tiers. nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free  
# is a possible 4th judge ONLY if your endpoint test returns choices — it  
# returned a malformed response under the old key.  
# JUDGE_MODELS=google/gemma-4-26b-a4b-it:free,dots-studio/dots-3-note-preview:free,liquid/lfm-2.5-2.6b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free  
  
# ---- Vision routing ----  
# Slugs allowed to receive raw image/PDF bytes. Text/code files go to every  
# model; binary attachments route OpenRouter calls to VISION_MODELS slugs and  
# Groq gets a text note instead (Groq chat is text-only). Gemini handles all  
# attachments natively. dots-3 is multimodal per its card.  
# VISION_MODELS is not env-overridable in config.py — edit the set there.  
  
# ---- Timing ----  
# Seconds between GENERATION calls (per provider key). Spaces requests so  
# free-tier keys stay under per-minute token limits.  
RATE_LIMIT_DELAY=3  
# Seconds between JUDGE calls. Judge calls are serialized through a per-job  
# asyncio.Lock, so the judge key still sees strictly serial, spaced requests —  
# but each candidate starts being judged the moment its agent finishes.  
JUDGE_DELAY=5  
# Safetywall: max attempts per provider call (rotate slug each retry).  
MAX_SAFETYWALL_TRIES=3  
# Seconds between safetywall retries.  
RETRY_DELAY=4  
  
# ---- Groq tiers) ----  
# Text-only endpoint; receives a "[Attached files...]" note when a job has  
# binary attachments.  
GROQ_MODEL_LIGHT=openai/gpt-oss-20b,allam-2-7b  
GROQ_MODEL_NORMAL=qwen/qwen3.8-27b,openai/gpt-oss-20b  
GROQ_MODEL_HEAVY=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
  
# ---- Gemini tiers ----  
# Single model across all tiers (native multimodal: text, image, PDF, docx).  
# Streaming via generate_content_stream with thinking deltas from  
# part.thought=True parts.  
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite  
GEMINI_MODEL_NORMAL=gemini-3.5-flash-lite,gemini-3.8-flash  
GEMINI_MODEL_HEAVY=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.7-flash  
  
# ---- Storage ----  
# Persistent data directory (users/jobs SQLite DBs live here). The systemd  
# unit sets this; the default matches the Pi install target.  
# DIZER_DATA_DIR=/mnt/dizerdata/dizercore
