# ---- API keys (required) ----  
OPENROUTER_API_KEY=your-openrouter-key  
GROQ_API_KEY=gsk_your_real_key_here  
GEMINI_API_KEY=your-google-ai-studio-key  
  
# ---- Data dir (SSD) ----  
DIZER_DATA_DIR=/mnt/dizerdata/dizercore  
PORT=8000  
  
# ---- Concurrency / throttle ----  
MAX_CONCURRENT_JOBS=2  
# Seconds to wait before EACH outbound model call (stops free-tier burst 429s).  
RATE_LIMIT_DELAY=6  
# Times a stage re-checks its own junk output before giving up.  
MAX_SAFETYWALL_TRIES=3  
  
# ---- OpenRouter model rotation, per complexity tier (comma-separated) ----  
# The pipeline tries each slug in order and rotates to the next on junk/error.  
OPENROUTER_MODELS_LIGHT=poolside/laguna-xs-2.1:free,nex-agi/nex-n2.5-mini:free  
OPENROUTER_MODELS_NORMAL=nex-agi/nex-n2.5-mini:free,poolside/laguna-s-2.1:free  
OPENROUTER_MODELS_HEAVY=nex-agi/nex-n2.5-pro:free,poolside/laguna-s-2.1:free  
  
# ---- Groq model rotation, per tier ----  
GROQ_MODELS_LIGHT=openai/gpt-oss-20b  
GROQ_MODELS_NORMAL=openai/gpt-oss-120b  
GROQ_MODELS_HEAVY=groq/compound  
  
# ---- Gemini model rotation, per tier ----  
# Flash Lite = 500 req/day (light/normal); full Flash = higher quality, 20/day (heavy).  
GEMINI_MODELS_LIGHT=gemini-3.5-flash-lite  
GEMINI_MODELS_NORMAL=gemini-3.1-flash-lite  
GEMINI_MODELS_HEAVY=gemini-3.6-flash
