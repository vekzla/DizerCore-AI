# DizerCore-AI    
# ============================================================================    
# .env.example — environment template for DizerCore-AI.    
# The installer writes the real values to /mnt/dizerdata/dizercore/dizercore.env    
# (set via DIZER_DATA_DIR). To change settings on a live install, edit that file    
# then:  sudo systemctl restart dizercore    
# ============================================================================    
    
# ---- API keys (required) ----    
# Coding agents authenticate with OPENROUTER_API_KEY_CODER — used by    
# _openrouter_once (runtime.cfg.openrouter_key) for every slug in the    
# *_MODEL_* tier lists below.    
OPENROUTER_API_KEY_CODER=your-openrouter-coder-key    
GROQ_API_KEY=gsk_your_real_key_here    
GEMINI_API_KEY=your-google-ai-studio-key    
    
# ---- Judge key (separate OpenRouter quota) ----    
# A SECOND OpenRouter key used ONLY by the judge pool — used by _judge_once    
# (runtime.cfg.judge_key). Scoring can't rate-limit the coding agents, and the    
# agents can't starve the judges. Leave blank to fall back to    
# OPENROUTER_API_KEY_CODER.    
OPENROUTER_API_KEY_JUDGE=    
    
# ---- Data dir (SSD) ----    
DIZER_DATA_DIR=/mnt/dizerdata/dizercore    
PORT=8000    
    
# ---- Concurrency / throttle ----    
MAX_CONCURRENT_JOBS=2    
# Seconds to wait before EACH outbound generation call (stops free-tier burst    
# 429s on the coder/Groq/Gemini keys).    
RATE_LIMIT_DELAY=6    
# Seconds between JUDGE calls. Judges run strictly in series — one candidate    
# fully scored before the next, and each judge call sleeps this first — so the    
# judge key never gets a burst that trips its per-minute token limit.    
JUDGE_DELAY=5    
# Max slugs tried per tier before giving up. Must be >= the longest tier list    
# so every fallback slug is reachable.    
MAX_SAFETYWALL_TRIES=8    
    
# ---- OpenRouter code-generation models, per complexity tier (comma-separated) --    
# The pipeline tries each slug in order and rotates to the next on junk/error.    
# Complexity 1-2 -> LIGHT, 3 -> NORMAL, 4-5 -> HEAVY. These slugs PRODUCE code    
# and authenticate with OPENROUTER_API_KEY_CODER.    
# NOTE: the env var name is {PROVIDER}_MODEL_{TIER} (singular MODEL), matching    
# _tier_map("OPENROUTER_MODEL", ...) in config.py.    
OPENROUTER_MODEL_LIGHT=poolside/laguna-xs-2.1:free,cohere/north-mini-code:free    
OPENROUTER_MODEL_NORMAL=poolside/laguna-s-2.1:free,google/gemma-4-26b-a4b-it:free    
OPENROUTER_MODEL_HEAVY=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free    
    
# ---- Groq model rotation, per tier (comma-separated) ----    
# VERIFIED limits (Groq console, Default Project):    
#   gpt-oss-20b / gpt-oss-120b / qwen3.6-27b / qwen3.8-27b:    
#       30 RPM, 1,000 req/day, 8K TOKENS/MINUTE (prompt+output), 200K tokens/day    
#   groq/compound, groq/compound-mini:    
#       30 RPM, 250 req/day, 70K TOKENS/MINUTE, no daily token cap    
# The 8K TPM cap on gpt-oss/qwen is the real limit — large prompts 429/413 there.    
# compound* has 70K TPM headroom but only 250 req/day, so it sits LAST as a    
# big-payload fallback. Audio (orpheus/whisper) + safety classifiers excluded.    
# Groq authenticates with GROQ_API_KEY only — no OpenRouter key involved.    
GROQ_MODEL_LIGHT=openai/gpt-oss-20b,qwen/qwen3.6-27b,groq/compound-mini    
GROQ_MODEL_NORMAL=openai/gpt-oss-120b,qwen/qwen3.8-27b,groq/compound    
GROQ_MODEL_HEAVY=openai/gpt-oss-120b,qwen/qwen3.8-27b,groq/compound    
    
# ---- Gemini model rotation, per tier (comma-separated) ----    
# Flash-Lite = 500 req/day, 15 RPM; full Flash = 20 req/day, 5 RPM. Lead every    
# tier with Flash-Lite for headroom; full Flash is heavy-only with Flash-Lite    
# as the fallback once the 20/day cap is exhausted.    
# Gemini authenticates with GEMINI_API_KEY only — no OpenRouter key involved.    
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite,gemini-3.1-flash-lite    
GEMINI_MODEL_NORMAL=gemini-3.5-flash-lite,gemini-3.1-flash-lite    
GEMINI_MODEL_HEAVY=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite    
    
# ---- Judge models — score each agent's output 0-100 with comments ----------    
# Judges authenticate with OPENROUTER_API_KEY_JUDGE (falls back to    
# OPENROUTER_API_KEY_CODER if unset). Candidates are scored ONE AT A TIME in    
# series, with JUDGE_DELAY between calls. For each candidate, judges are tried    
# IN ORDER; a judge that errors or returns non-numeric output is DISCARDED and    
# the next slug is tried, falling through to JUDGE_FALLBACK_MODELS if needed.    
# The FIRST usable score wins per agent — scores are NOT averaged — and the    
# agent with the highest score is reported as best. Each judge reply includes    
# SCORE: <0-100> plus COMMENTS: <explanation>, which is shown in the UI.    
#    
# Judge lineup:    
#   1. thinkingmachines/inkling:free                   — primary judge    
#   2. thinkingmachines/inkling-small:free             — lighter fallback    
#   3. inclusionai/ling-3.0-flash-vl:free              — fast, scores reliably    
#   4. nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free — reasoning judge    
# NOTE: nvidia/nemotron-3.5-content-safety:free was REMOVED — it is a content    
# safety classifier that returns labels, not a 0-100 score, so it always failed    
# _parse_score and burned a rotation slot. nvidia/nemotron-3-super-120b-a12b:free    
# was moved back to the HEAVY coder tier (it's a coding agent, not a judge).    
JUDGE_MODELS=thinkingmachines/inkling:free,thinkingmachines/inkling-small:free,inclusionai/ling-3.0-flash-vl:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free    
# Optional spare judges (comma-separated); tried after every JUDGE_MODELS slug    
# has failed to produce a numeric score.    
JUDGE_FALLBACK_MODELS=
